generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEW
  HIRED
  REJECTED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  REMOTE
  HYBRID
  INTERNSHIP
}

// ─────────────────────────────────────────────────────────────────────────────
// USER (Admin only)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  role          Role     @default(ADMIN)
  name          String?  @default("Admin")
  avatar        String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens RefreshToken[]
  passwordResets PasswordReset[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

// ─────────────────────────────────────────────────────────────────────────────
// TEAM MANAGEMENT (Developers are showcase content only - NO login)
// ─────────────────────────────────────────────────────────────────────────────

model TeamMember {
  id             String   @id @default(uuid())
  name           String
  position       String
  avatar         String?
  bio            String?
  skills         String[] @default([])
  technologies   String[] @default([])
  experience     String?  // e.g. "5+ Years"
  portfolioLinks String[] @default([])
  githubUrl      String?
  linkedinUrl    String?
  email          String?
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("team_members")
}

// ─────────────────────────────────────────────────────────────────────────────
// SERVICES & SERVICE CATEGORIES
// ─────────────────────────────────────────────────────────────────────────────

model ServiceCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services    Service[]

  @@map("service_categories")
}

model Service {
  id           String           @id @default(uuid())
  title        String
  slug         String           @unique
  categoryId   String?
  category     ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  banner       String?
  icon         String?
  overview     String
  features     String[]         @default([])
  technologies String[]         @default([])
  faq          Json?            @default("[]")
  ctaText      String?
  ctaUrl       String?
  order        Int              @default(0)
  isActive     Boolean          @default(true)
  isFeatured   Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("services")
}

// ─────────────────────────────────────────────────────────────────────────────
// PORTFOLIO & INDUSTRIES
// ─────────────────────────────────────────────────────────────────────────────

model Industry {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("industries")
}

model PortfolioProject {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  coverImage   String?
  gallery      String[] @default([])
  description  String
  overview     String?
  technologies String[] @default([])
  industry     String?
  features     String[] @default([])
  results      String[] @default([])
  liveUrl      String?
  isFeatured   Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("portfolio_projects")
}

// ─────────────────────────────────────────────────────────────────────────────
// CAREERS (JOBS & APPLICATIONS)
// ─────────────────────────────────────────────────────────────────────────────

model Job {
  id               String           @id @default(uuid())
  title            String
  slug             String           @unique
  department       String
  location         String           @default("Remote")
  type             JobType          @default(FULL_TIME)
  experience       String?          // e.g. "3-5 years"
  description      String
  requirements     String[]         @default([])
  responsibilities String[]         @default([])
  salaryRange      String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  applications     JobApplication[]

  @@map("jobs")
}

model JobApplication {
  id           String            @id @default(uuid())
  jobId        String?
  job          Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  firstName    String
  lastName     String
  email        String
  phone        String?
  resumeUrl    String?
  coverLetter  String?
  skills       String[]          @default([])
  experience   String?
  linkedinUrl  String?
  portfolioUrl String?
  status       ApplicationStatus @default(PENDING)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("job_applications")
}

// ─────────────────────────────────────────────────────────────────────────────
// BLOGS
// ─────────────────────────────────────────────────────────────────────────────

model Blog {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  coverImage  String?
  content     String
  excerpt     String?
  category    String?
  authorName  String?   @default("BrainForge26 Team")
  tags        String[]  @default([])
  isPublished Boolean   @default(true)
  publishedAt DateTime? @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blogs")
}

// ─────────────────────────────────────────────────────────────────────────────
// TESTIMONIALS
// ─────────────────────────────────────────────────────────────────────────────

model Testimonial {
  id         String   @id @default(uuid())
  clientName String
  company    String?
  position   String?
  avatar     String?
  rating     Int      @default(5)
  text       String
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("testimonials")
}

// ─────────────────────────────────────────────────────────────────────────────
// FAQS
// ─────────────────────────────────────────────────────────────────────────────

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String?  @default("General")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("faqs")
}

// ─────────────────────────────────────────────────────────────────────────────
// TECHNOLOGIES
// ─────────────────────────────────────────────────────────────────────────────

model Technology {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  icon        String?
  category    String?  // e.g. "Frontend", "Backend", "Cloud", "Mobile", "AI & ML", "Database"
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("technologies")
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENT LOGOS / PARTNERS
// ─────────────────────────────────────────────────────────────────────────────

model ClientLogo {
  id         String   @id @default(uuid())
  name       String
  logoUrl    String
  websiteUrl String?
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("client_logos")
}

// ─────────────────────────────────────────────────────────────────────────────
// MEDIA LIBRARY
// ─────────────────────────────────────────────────────────────────────────────

model MediaFile {
  id        String   @id @default(uuid())
  name      String
  url       String
  publicId  String
  mimeType  String?
  sizeBytes Int?
  category  String?  @default("general")
  createdAt DateTime @default(now())

  @@map("media_files")
}

// ─────────────────────────────────────────────────────────────────────────────
// SITE SETTINGS
// ─────────────────────────────────────────────────────────────────────────────

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTACT MESSAGES
// ─────────────────────────────────────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  service   String?
  message   String
  isRead    Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}
