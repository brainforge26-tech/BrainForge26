# Backend Production Environment Variables
PORT=5001
NODE_ENV=production
DATABASE_URL="postgresql://brainforge26_user:CHANGE_THIS_TO_SECURE_PASSWORD@localhost:5432/brainforge26?schema=public"

# Authentication Secrets (generate with `openssl rand -base64 32`)
JWT_ACCESS_SECRET="CHANGE_THIS_TO_RANDOM_ACCESS_SECRET_KEY_MIN_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_RANDOM_REFRESH_SECRET_KEY_MIN_32_CHARS"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Domain Configuration
CLIENT_URL="https://brainforge26.tech"
